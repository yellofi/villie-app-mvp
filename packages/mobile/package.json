{
  "name": "@villie/mobile",
  "version": "0.0.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest --watchAll=false",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "@supabase/supabase-js": "^2.106.1",
    "@villie/shared": "workspace:*",
    "expo": "^53.0.0",
    "expo-status-bar": "*",
    "nativewind": "^4.2.4",
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "*",
    "jest": "^29.0.0",
    "jest-expo": "~53.0.0",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.11",
    "typescript": "^5.4.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "utils",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/src/utils/**/*.test.ts"
        ],
        "moduleNameMapper": {
          "^@villie/shared(.*)$": "<rootDir>/../shared/src$1"
        },
        "transform": {
          "^.+\\.tsx?$": [
            "ts-jest",
            {
              "tsconfig": {
                "strict": true,
                "esModuleInterop": true
              }
            }
          ]
        }
      },
      {
        "displayName": "components",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/src/screens/**/*.test.{ts,tsx}",
          "<rootDir>/src/components/**/*.test.{ts,tsx}"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/"
        ],
        "transformIgnorePatterns": [
          "node_modules/(?!(\\.pnpm/(@react-native|react-native|expo|nativewind|@expo|@testing-library|@react-navigation)|react-native|@react-native|expo|nativewind|@expo|@testing-library|@react-navigation))"
        ],
        "moduleNameMapper": {
          "^@villie/shared(.*)$": "<rootDir>/../shared/src$1"
        }
      }
    ]
  }
}
